# ---- required ----
BOT_TOKEN=123456:ABC-your-token-from-BotFather

# ---- paths ----
DB_PATH=data/bot.db
PAGES_DIR=assets/pages

# ---- defaults for new groups ----
DEFAULT_TIMEZONE=Asia/Damascus
LOG_LEVEL=INFO

# ---- run mode ----
# Leave WEBHOOK_URL empty to run with long polling (default).
# Set it to switch to webhook mode; the four vars below apply only then.
WEBHOOK_URL=
SECRET_TOKEN=
PORT=8443
URL_PATH=
