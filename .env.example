# ---- required ----
BOT_TOKEN=123456:ABC-your-token-from-BotFather

# ---- paths ----
DB_PATH=data/bot.db
PAGES_DIR=assets/pages

# ---- defaults for new groups ----
DEFAULT_TIMEZONE=Asia/Damascus
LOG_LEVEL=INFO

# ---- owner panel ----
# Telegram user ids that may open /owner in a private chat, comma separated.
# Leave empty and the panel answers nobody. Get your id from @userinfobot.
OWNER_IDS=

# ---- backups ----
# A nightly copy of the SQLite database, taken with SQLite's online backup API
# so it is consistent while the bot is running. BACKUP_TIME is in
# DEFAULT_TIMEZONE, and 03:30 sits between the last reminder and the first send.
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_KEEP=7
BACKUP_TIME=03:30

# Raise these if api.telegram.org is slow to reach from your server.
CONNECT_TIMEOUT=30
READ_TIMEOUT=30

# ---- run mode ----
# Leave WEBHOOK_URL empty to run with long polling (default).
# Set it to switch to webhook mode; the four vars below apply only then.
WEBHOOK_URL=
SECRET_TOKEN=
PORT=8443
URL_PATH=
